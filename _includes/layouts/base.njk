<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or 'My Eleventy Site' }}</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <style>
    /* Basic reset & layout */
    body { margin: 0; font-family: system-ui, sans-serif; display: flex; flex-direction: column; min-height: 100vh; background: transparent; color: #c9d1d9; position: relative; }
    #vista-bg { opacity: 0; transition: opacity 1.5s ease-in; }
    header { background: #1a1a1a; color: white; padding: 1rem; position: relative; z-index: 1; }
    header nav ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 1rem; }
    header nav a { color: #fff; text-decoration: none; font-weight: 500; }
    header nav a:hover { text-decoration: underline; }
    main { flex: 1; padding: 2rem; max-width: 800px; margin: 0 auto; color: #c9d1d9; position: relative; z-index: 1; }
    footer { position: relative; z-index: 1; }
    footer a:hover { text-decoration: underline; }

    /* Sections */
    .section { margin-bottom: 3rem; padding: 1.5rem; background: rgba(22, 27, 34, 0.65); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; position: relative; z-index: 1; }
    .section h2 { font-size: 1.75rem; margin-bottom: 1.5rem; color: #f0f6fc; border-bottom: 1px solid #30363d; padding-bottom: 0.5rem; }

    /* Blog */
    .blog-entry { padding: 1rem 0; border-bottom: 1px solid #30363d; }
    .blog-entry:last-child { border-bottom: none; }
    .blog-entry-header { display: flex; align-items: baseline; gap: 1rem; }
    .blog-entry-header a { color: #58a6ff; text-decoration: none; font-size: 1.25rem; font-weight: 600; }
    .blog-entry-header a:hover { text-decoration: underline; }
    .blog-entry-date { font-size: 0.9rem; color: #8b949e; white-space: nowrap; }
    .blog-empty { color: #8b949e; }

    /* About */
    .about-content { line-height: 1.7; }
    .about-name { font-size: 1.25rem; font-weight: 600; color: #f0f6fc; margin: 0; }
    .about-title { color: #58a6ff; margin: 0.25rem 0 0.75rem; }
    .about-bio { margin: 0 0 0.5rem; }
    .about-location { color: #8b949e; font-size: 0.9rem; margin: 0; }

    /* Timeline */
    .timeline { position: relative; padding-left: 2rem; }
    .timeline::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: #30363d; }
    .timeline-item { position: relative; margin-bottom: 1.5rem; }
    .timeline-marker { position: absolute; left: -2.2rem; top: 0.6rem; width: 14px; height: 14px; border-radius: 50%; background: #58a6ff; border: 2px solid #0d1117; margin-left: -6px; transform: translateX(1px); transition: background 0.3s, box-shadow 0.3s; }
    .timeline-marker.active { background: #FF6EC7; animation: fireflyGlow var(--glow-duration, 2s) ease-in-out infinite var(--glow-delay, 0s); }
    .timeline-content { background: #161b22; border: 1px solid #30363d; border-radius: 6px; overflow: hidden; transition: box-shadow 0.3s; }
    .timeline-content:hover { animation: cardGlow var(--glow-duration, 2s) ease-in-out infinite var(--glow-delay, 0s); }
    .timeline-header { display: flex; align-items: center; padding: 1rem; cursor: pointer; gap: 0.75rem; flex-wrap: wrap; transition: background 0.2s; }
    .timeline-header:hover { background: #1c2128; }
    .timeline-date { font-size: 0.8rem; color: #8b949e; white-space: nowrap; }
    .timeline-company { display: flex; flex-direction: column; gap: 2px; }
    .company-logo { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
    .company-name { font-weight: 600; color: #f0f6fc; }
    .company-name a { color: #58a6ff; text-decoration: none; }
    .company-name a:hover { text-decoration: underline; }
    .company-role { font-size: 0.85rem; color: #8b949e; flex-shrink: 0; margin-left: auto; }
    .toggle-icon { font-size: 0.7rem; color: #8b949e; transition: transform 0.3s; }
    .timeline-header.expanded .toggle-icon { transform: rotate(180deg); }
    @keyframes cardGlow {
      0%, 100% { box-shadow: 0 0 8px rgba(255, 110, 199, 0.3); }
      50% { box-shadow: 0 0 20px rgba(255, 110, 199, 0.6), 0 0 40px rgba(255, 110, 199, 0.2); }
    }
    @keyframes fireflyGlow {
      0%, 100% { box-shadow: 0 0 5px rgba(255, 110, 199, 0.5); }
      50% { box-shadow: 0 0 15px rgba(255, 110, 199, 0.9), 0 0 30px rgba(255, 110, 199, 0.4); }
    }
    .timeline-details { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
    .timeline-details.open { max-height: 500px; }
    .accomplishments { list-style: none; padding: 0 1rem 1rem; margin: 0; }
    .accomplishments li { position: relative; padding-left: 1.2rem; margin-bottom: 0.5rem; color: #c9d1d9; line-height: 1.5; }
    .accomplishments li::before { content: '▸'; position: absolute; left: 0; color: #58a6ff; }

    /* Hero Rain */
    .hero-container { position: relative; overflow: hidden; width: 100vw; margin-left: calc(-50vw + 50%); }
    .hero-container img { width: 100%; height: 400px; object-fit: cover; display: block; }
    .rain-container { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }
    .rain-drop { position: absolute; bottom: 100%; width: 30px; height: 140px; pointer-events: none; animation: drop 0.5s linear infinite; }
    @keyframes drop {
      0% { transform: translateY(0); }
      75% { transform: translateY(400px); }
      100% { transform: translateY(400px); }
    }
    .rain-stem { width: 5px; height: 60%; margin-left: 12px; background: linear-gradient(to bottom, rgba(255, 110, 199, 0), rgba(255, 110, 199, 0.45)); animation: stem 0.5s linear infinite; }
    @keyframes stem {
      0% { opacity: 1; }
      65% { opacity: 1; }
      75% { opacity: 0; }
      100% { opacity: 0; }
    }
    .rain-splat { width: 30px; height: 20px; border-top: 8px dotted rgba(255, 110, 199, 0.7); border-radius: 50%; opacity: 1; transform: scale(0); animation: splat 0.5s linear infinite; }
    @keyframes splat {
      0% { opacity: 1; transform: scale(0); }
      80% { opacity: 1; transform: scale(0); }
      90% { opacity: 0.5; transform: scale(1); }
      100% { opacity: 0; transform: scale(1.5); }
    }

    /* Books */
    .chart-container { position: relative; height: 250px; margin-bottom: 2rem; }
    .books-year { margin-bottom: 1.5rem; }
    .books-year-header { display: flex; align-items: center; padding: 0.75rem 1rem; background: #161b22; border: 1px solid #30363d; border-radius: 6px; cursor: pointer; gap: 0.75rem; transition: background 0.2s; }
    .books-year-header:hover { background: #1c2128; }
    .books-year-name { font-size: 1.25rem; font-weight: 600; color: #f0f6fc; }
    .books-year-count { font-size: 0.85rem; color: #8b949e; }
    .books-year-toggle { font-size: 0.7rem; color: #8b949e; margin-left: auto; transition: transform 0.3s; }
    .books-year-header.expanded .books-year-toggle { transform: rotate(180deg); }
    .books-year-details { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
    .books-year-details.open { max-height: 5000px; }
    .books-month { margin-bottom: 0.75rem; padding-left: 1.5rem; }
    .books-month-header { display: flex; align-items: center; padding: 0.75rem 1rem; background: #161b22; border: 1px solid #30363d; border-radius: 6px; cursor: pointer; gap: 0.75rem; transition: background 0.2s; }
    .books-month-header:hover { background: #1c2128; }
    .books-month-name { font-weight: 600; color: #FF6EC7; }
    .books-month-count { font-size: 0.85rem; color: #8b949e; }
    .books-month-toggle { font-size: 0.7rem; color: #8b949e; margin-left: auto; transition: transform 0.3s; }
    .books-month-header.expanded .books-month-toggle { transform: rotate(180deg); }
    .books-month-details { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
    .books-month-details.open { max-height: 800px; }
    .book-card { background: #161b22; border: 1px solid #30363d; border-left: 3px solid #FF6EC7; border-radius: 4px; padding: 1rem; margin: 0.5rem 0; }
    .book-title { font-weight: 600; color: #f0f6fc; margin: 0; }
    .book-author { font-size: 0.9rem; color: #8b949e; margin: 0.25rem 0; }
    .book-notes { font-size: 0.9rem; color: #c9d1d9; line-height: 1.6; margin: 0.5rem 0 0; padding: 0.5rem; background: #0d1117; border-radius: 4px; }
  </style>
</head>
<body>
  <canvas id="vista-bg"></canvas>
  <header>
    <nav>
      <ul>
        {% if page.url == "/" %}
          <li><a href="/">Home</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#cv">Experience</a></li>
          <li><a href="#books">Books</a></li>
          <li><a href="/blog/">Blog</a></li>
        {% elif page.url and "/blog" in page.url %}
          <li><a href="/">Home</a></li>
          <li><a href="/blog/">Blog</a></li>
        {% else %}
          <li><a href="/">Home</a></li>
        {% endif %}
      </ul>
    </nav>
  </header>

  <main>
    {% if page.url == "/" %}
    <div class="hero-container">
      <img src="images/header.jpg" alt="Header" />
      <div class="rain-container"></div>
    </div>
    <h1>{{ title }}</h1>
    {% endif %}
    {{ content | safe }}
  </main>

  <footer>
    <p>🐙 Github stuff: <a href="{{ github_url or 'https://github.com/hanleyjames' }}" target="_blank" rel="noopener">{{ github_url or 'GitHub Repository' }}</a></p>
  </footer>

  <script>
    function toggleJob(header) {
      const details = header.nextElementSibling;
      const marker = header.parentElement.previousElementSibling;
      details.classList.toggle('open');
      header.classList.toggle('expanded');
      marker.classList.toggle('active');
    }

    function makeItRain() {
      var container = document.querySelector('.rain-container');
      if (!container) return;
      container.innerHTML = '';

      var neonColors = ['#FF6EC7', '#00FF99', '#00CCFF', '#FF3366', '#CCFF00', '#FF6600', '#9966FF'];

      var increment = 0;
      var drops = '';

      while (increment < 100) {
        var randoHundo = Math.floor(Math.random() * 98 + 1);
        var randoFiver = Math.floor(Math.random() * 4 + 2);
        increment += randoFiver;
        var bottomPos = randoFiver + randoFiver - 1 + 100;
        var delay = '0.' + randoHundo + 's';
        var duration = '0.5' + randoHundo + 's';
        var neonColor = neonColors[Math.floor(Math.random() * neonColors.length)];
        drops += '<div class="rain-drop" style="left:' + increment + '%;bottom:' + bottomPos + '%;animation-delay:' + delay + ';animation-duration:' + duration + ';"><div class="rain-stem" style="animation-delay:' + delay + ';animation-duration:' + duration + ';"></div><div class="rain-splat" style="animation-delay:' + delay + ';animation-duration:' + duration + ';border-top-color:' + neonColor + ';"></div></div>';
      }

      container.innerHTML = drops;
    }

    document.addEventListener('DOMContentLoaded', function() {
      makeItRain();

      var cards = document.querySelectorAll('.timeline-content');
      cards.forEach(function(card) {
        var duration = (1.5 + Math.random() * 2).toFixed(2);
        var delay = (Math.random() * 2).toFixed(2);
        card.style.setProperty('--glow-duration', duration + 's');
        card.style.setProperty('--glow-delay', delay + 's');
        var marker = card.previousElementSibling;
        if (marker) {
          marker.style.setProperty('--glow-duration', duration + 's');
          marker.style.setProperty('--glow-delay', delay + 's');
        }
      });

      initBooks();
    });

    function initBooks() {
      var books = (typeof booksData !== 'undefined') ? booksData : [];
      if (!books.length) return;

      var monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      var grouped = {};
      books.forEach(function(book) {
        if (!grouped[book.year]) grouped[book.year] = {};
        if (!grouped[book.year][book.month]) grouped[book.year][book.month] = [];
        grouped[book.year][book.month].push(book);
      });
      var years = Object.keys(grouped).sort();

      var listEl = document.getElementById('booksList');
      if (!listEl) return;

      var html = '';
      years.forEach(function(year) {
        var monthKeys = Object.keys(grouped[year]).sort();
        var totalBooks = monthKeys.reduce(function(s, m) { return s + grouped[year][m].length; }, 0);
        html += '<div class="books-year" data-year="' + year + '">';
        html += '<div class="books-year-header" onclick="toggleYear(this)">';
        html += '<span class="books-year-name">' + year + '</span>';
        html += '<span class="books-year-count">' + totalBooks + ' book' + (totalBooks !== 1 ? 's' : '') + '</span>';
        html += '<span class="books-year-toggle">▼</span>';
        html += '</div>';
        html += '<div class="books-year-details">';
        monthKeys.forEach(function(month) {
          var monthBooks = grouped[year][month];
          html += '<div class="books-month" data-month="' + month + '">';
          html += '<div class="books-month-header" onclick="toggleMonth(this)">';
          html += '<span class="books-month-name">' + monthNames[month - 1] + '</span>';
          html += '<span class="books-month-count">' + monthBooks.length + ' book' + (monthBooks.length > 1 ? 's' : '') + '</span>';
          html += '<span class="books-month-toggle">▼</span>';
          html += '</div>';
          html += '<div class="books-month-details">';
          monthBooks.forEach(function(book) {
            html += '<div class="book-card">';
            html += '<p class="book-title">' + book.title + '</p>';
            html += '<p class="book-author">' + book.author + '</p>';
            html += '<p class="book-notes">' + book.notes + '</p>';
            html += '</div>';
          });
          html += '</div></div>';
        });
        html += '</div></div>';
      });
      listEl.innerHTML = html;

      var chartEl = document.getElementById('booksChart');
      if (!chartEl) return;

      var yearCounts = {};
      books.forEach(function(book) {
        if (!yearCounts[book.year]) yearCounts[book.year] = new Array(12).fill(0);
        yearCounts[book.year][book.month - 1]++;
      });

      var datasets = Object.keys(yearCounts).sort().map(function(year) {
        return {
          label: year,
          data: yearCounts[year],
          backgroundColor: 'rgba(255, 110, 199, 0.6)',
          borderColor: '#FF6EC7',
          borderWidth: 1
        };
      });

      new Chart(chartEl, {
        type: 'bar',
        data: {
          labels: monthNames,
          datasets: datasets
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            intersect: false,
            mode: 'index'
          },
          plugins: {
            legend: {
              labels: { color: '#c9d1d9', font: { family: 'system-ui' } }
            }
          },
          scales: {
            x: { ticks: { color: '#8b949e' }, grid: { color: '#21262d' } },
            y: { beginAtZero: true, ticks: { color: '#8b949e', stepSize: 1 }, grid: { color: '#21262d' } }
          },
          onClick: function(e, elements) {
            if (elements.length) {
              var datasetIdx = elements[0].datasetIndex;
              var monthIdx = elements[0].index;
              var year = datasets[datasetIdx].label;
              var monthNum = monthIdx + 1;
              var selector = '.books-year[data-year="' + year + '] .books-month[data-month="' + monthNum + '"]';
              var monthEl = document.querySelector(selector);
              if (monthEl) {
                var yearEl = monthEl.parentElement.parentElement;
                var yearDetails = yearEl.querySelector('.books-year-details');
                var yearHeader = yearEl.querySelector('.books-year-header');
                yearDetails.classList.add('open');
                yearHeader.classList.add('expanded');
                monthEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                var details = monthEl.querySelector('.books-month-details');
                var header = monthEl.querySelector('.books-month-header');
                details.classList.add('open');
                header.classList.add('expanded');
              }
            }
          }
        }
      });
    }

    function toggleYear(header) {
      var yearEl = header.parentElement;
      var details = yearEl.querySelector('.books-year-details');
      details.classList.toggle('open');
      header.classList.toggle('expanded');
    }

    function toggleMonth(header) {
      var monthEl = header.parentElement;
      var details = monthEl.querySelector('.books-month-details');
      details.classList.toggle('open');
      header.classList.toggle('expanded');
    }
  </script>
  <script src="vista-bg.js"></script>
</body>
</html>
