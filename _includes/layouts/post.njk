<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or 'Untitled Post' }}</title>
  <style>
    body { margin: 0; font-family: system-ui, sans-serif; display: flex; flex-direction: column; min-height: 100vh; background: transparent; color: #c9d1d9; position: relative; }
    #vista-bg { opacity: 0; transition: opacity 1.5s ease-in; }
    header { background: #1a1a1a; color: white; padding: 1rem; position: relative; z-index: 1; }
    header nav ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 1rem; }
    header nav a { color: #fff; text-decoration: none; font-weight: 500; }
    header nav a:hover { text-decoration: underline; }
    main { flex: 1; padding: 2rem; max-width: 800px; margin: 0 auto; color: #c9d1d9; position: relative; z-index: 1; }
    footer { position: relative; z-index: 1; }
    footer a:hover { text-decoration: underline; }

    .section { margin-bottom: 3rem; padding: 1.5rem; background: rgba(22, 27, 34, 0.65); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; position: relative; z-index: 1; }
    .section h2 { font-size: 1.75rem; margin-bottom: 1.5rem; color: #f0f6fc; border-bottom: 1px solid #30363d; padding-bottom: 0.5rem; }

    .post-image { width: 100%; max-height: 400px; object-fit: cover; border-radius: 6px; margin-bottom: 1.5rem; }
    .post-title { font-size: 2rem; font-weight: 600; color: #f0f6fc; margin: 0 0 0.5rem; }
    .post-date { font-size: 0.9rem; color: #8b949e; margin: 0 0 1.5rem; }
    .post-body { line-height: 1.7; }
    .post-body p { margin: 0 0 1rem; }
    .post-body h2 { font-size: 1.5rem; color: #f0f6fc; margin: 1.5rem 0 0.75rem; }
    .post-body h3 { font-size: 1.25rem; color: #f0f6fc; margin: 1.25rem 0 0.5rem; }
    .post-body a { color: #58a6ff; text-decoration: none; }
    .post-body a:hover { text-decoration: underline; }
    .post-body code { background: rgba(13, 17, 23, 0.8); padding: 0.2rem 0.4rem; border-radius: 4px; font-size: 0.9em; }
    .post-body pre { background: rgba(13, 17, 23, 0.8); padding: 1rem; border-radius: 6px; overflow-x: auto; margin: 1rem 0; }
    .post-body pre code { background: none; padding: 0; }
    .post-body ul, .post-body ol { margin: 0 0 1rem; padding-left: 1.5rem; }
    .post-body li { margin-bottom: 0.5rem; }
    .post-body blockquote { border-left: 3px solid #FF6EC7; padding-left: 1rem; margin: 1rem 0; color: #8b949e; }
  </style>
</head>
<body>
  <canvas id="vista-bg"></canvas>
  <header>
    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/blog/">Blog</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <section class="section">
      {% if image %}
      <img src="{{ image }}" alt="{{ title }}" class="post-image" />
      {% endif %}
      <h1 class="post-title">{{ title }}</h1>
      <p class="post-date">{{ date | dateFormat }}</p>
      <div class="post-body">
        {{ content | safe }}
      </div>
    </section>
  </main>

  <footer>
    <p>&#x1F419; Github stuff: <a href="{{ github_url or 'https://github.com/hanleyjames' }}" target="_blank" rel="noopener">{{ github_url or 'GitHub Repository' }}</a></p>
  </footer>

  <script src="vista-bg.js"></script>
</body>
</html>
